{
  "manifest_version": 3,
  "name": "No Coin Pilot",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Local visual lane assistant for Subway Surfers. No currency or save modifications.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage", "debugger"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html"}
}
